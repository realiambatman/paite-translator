# Optional — only needed for private/gated models
HF_TOKEN=

# Hugging Face model repo (PyTorch fallback)
MODEL_REPO=sensix-zo/nllb-paite-600m-v15

# CTranslate2 — faster CPU inference (upload converted model to HF once)
INFERENCE_BACKEND=ctranslate2
CT2_MODEL_REPO=sensix-zo/nllb-paite-600m-v15-ct2
CT2_COMPUTE_TYPE=int8

# Inference tuning (CPU defaults: 1 beam, batch 1 — faster on VPS)
# NUM_BEAMS=5
# CPU_BATCH_SIZE=1
# GPU_BATCH_SIZE=8
# CT2_INTER_THREADS=2
# CT2_INTRA_THREADS=1

# Decoding quality. Beams improve NLLB output noticeably; 3 is a good CPU
# balance (2-3x slower per sentence than 1). Repetition penalty and no-repeat
# n-gram size stop the model looping the same words.
# CPU_NUM_BEAMS=3
# NUM_BEAMS=            # force a value on any device
# REPETITION_PENALTY=1.1
# NO_REPEAT_NGRAM_SIZE=3
# MAX_ALTERNATIVES=3    # n-best shown as "other suggestions" for short inputs

# Sentences per HF decode unit (default 1 — one sentence; fallback runs per sentence).
# Optional: set 2 to pair sentences for more context (weaker per-sentence fallback).
# SENTENCE_GROUP_SIZE=1
# SENTENCE_GROUP_SIZE=2

# Re-run a tiny translation every N seconds so the OS does not swap model
# weights to disk after idle. Default: 300 (5 min).
# On an 8GB VPS, set 0 to disable background pings and reduce RAM/CPU pressure:
# KEEP_WARM_INTERVAL_SEC=0
# KEEP_WARM_INTERVAL_SEC=300

# Run first inference in background after load (set 0 to skip). Default: on.
# WARMUP_ON_START=1

# Baked Docker images set HF_HUB_OFFLINE=1 after model download in the Dockerfile.
# Do NOT set HF_HUB_OFFLINE in Coolify — it breaks the Docker build (model download needs network).

# TEMPORARY: if Paite output copies English, split the sentence and retry.
# Delete backend/copy_through_fallback.py when the model improves.
# COPY_THROUGH_CHUNK_FALLBACK=1
# COPY_THROUGH_RATIO=0.80
# COPY_THROUGH_MAX_CLAUSE_WORDS=8
# COPY_THROUGH_AGGRESSIVE_WORDS=4

# Google Cloud Translation API key (server-side only)
GOOGLE_TRANSLATE_API_KEY=

# App-side daily Google character cap (independent of GCP console quota)
# 16000 ≈ under 500k/month free tier. Use 0 or unlimited to disable app cap.
GOOGLE_DAILY_CHAR_LIMIT=16000

# Max input size (~200 tokens / ~800 characters)
MAX_TRANSLATION_TOKENS=200

# Server
PORT=8000
CORS_ORIGINS=*
STATIC_DIR=/app/static

# Unique per deploy — busts cached JS on mobile after rebuilds.
# Coolify: set BUILD_ID=${SOURCE_COMMIT} as a Docker build arg.
BUILD_ID=

# Firebase web config — baked into frontend at Docker BUILD (Coolify env vars)
# Get these from Firebase Console → Project settings → General → Your apps → Web
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_TRANSLATIONS_COLLECTION=translations
VITE_FIREBASE_GOOGLE_QUOTA_COLLECTION=google_translate_quota

# MinIO / S3-compatible storage for uploaded files and camera captures (server-side only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_STORAGE_PREFIX=paite-translator/uploads

# Admin panel (/admin) — read-only view of logged translations and uploads
# Password typed into the admin page. Leave blank to disable the panel.
ADMIN_PASSWORD=
# Credentials so the server can READ Firestore (browser rules are write-only).
# Either: Firebase Console → Project settings → Service accounts → Generate new
# private key, and paste the whole JSON on one line.
# Or, if key creation is blocked on your project: run
#   gcloud auth application-default login
# and paste the contents of ~/.config/gcloud/application_default_credentials.json
# (an "authorized_user" JSON for your own Google account).
# FIREBASE_SERVICE_ACCOUNT_FILE can point at either kind of file instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
# Project id is read from a service-account key automatically; with gcloud user
# credentials it falls back to VITE_FIREBASE_PROJECT_ID, or set it here.
# FIREBASE_PROJECT_ID=
# Firestore collection names used by the feedback loop and glossary
VITE_FIREBASE_CORRECTIONS_COLLECTION=corrections
FIREBASE_GLOSSARY_COLLECTION=glossary

# Optional: "Simplify English" button. Rewrites long English into short plain
# sentences with Claude before the Paite model sees it. Leave blank to hide.
ANTHROPIC_API_KEY=
# SIMPLIFY_MODEL=claude-opus-5-5
